# Groq API Key - get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_her

# Flask Configuration
FLASK_SECRET_KEY=change_this_to_a_random_secret_key_in_production
FLASK_ENV=development
FLASK_DEBUG=true

# File Upload Settings
MAX_UPLOAD_SIZE_MB=50
UPLOAD_FOLDER=uploads

# FAISS Index Storage
FAISS_INDEX_DIR=faiss_indexes

# Database
DATABASE_URL=sqlite:///viva_simulator.db

# Embedding Model (local, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Groq LLM Model
GROQ_LLM_MODEL=openai/gpt-oss-120b

# Groq Whisper Model for Speech-to-Text
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Chunk settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Evaluation Rubric Weights (must sum to 100)
WEIGHT_TECHNICAL_CORRECTNESS=40
WEIGHT_DEPTH_OF_REASONING=30
WEIGHT_PROJECT_SPECIFIC=20
WEIGHT_COMPLETENESS=10

# Email / SMTP Configuration
# To send real emails to your inbox or other recipients (e.g. Gmail):
# 1. Enable 2-Step Verification in your Google Account
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your details below:
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hulk44678@gmail.com
